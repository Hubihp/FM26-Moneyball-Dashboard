{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "python -m fm_moneyball --bez-przegladarki"
  },
  "portsAttributes": {
    "8765": {
      "label": "Aplikacja",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8765
  ]
}
